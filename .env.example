PORT=3000

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

OPENAI_API_KEY=SUA_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Depois que o Netlify gerar o domínio, coloque-o aqui.
# Mais de um domínio pode ser separado por vírgula.
# Durante o primeiro teste, você pode deixar vazio.
WEB_ALLOWED_ORIGINS=
WEB_CHAT_SIGNING_SECRET=COLOQUE_UMA_CHAVE_LONGA_E_ALEATORIA_AQUI

# WhatsApp continua opcional enquanto a Meta não estiver liberada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=condominio_reserva_serra_token
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
